"""Render actual ERB offline and observe the app-owned browser surfaces."""
from pathlib import Path
from builtins import ValueError, bool, str, int, object, list
import subprocess
import shutil
import http.server
import functools
import threading
import json
from playwright.sync_api import sync_playwright

def require(condition ∈ bool, reason ∈ str) → None:
    if not condition:
        raise ValueError(reason)

def local_requests_only(route ∈ object) → None:
    if str(route.request.url).startswith("http://127.0.0.1:"):
        route.continue_()
    else:
        route.abort()

def own_surface(page ∈ object) → bool:
    return bool(page.evaluate("getComputedStyle(document.body).backgroundColor === 'rgb(33, 33, 33)' && getComputedStyle(document.body).color === 'rgb(244, 244, 244)'"))

root ∈ Path ← Path(__file__).resolve().parents[3]
output ∈ Path ← root.joinpath("build/charcoal")
output.mkdir(parents=True, exist_ok=True)
site ∈ Path ← output.joinpath("site")
baseline_site ∈ Path ← output.joinpath("baseline")
shutil.copytree(root.joinpath("public"), site, dirs_exist_ok=True)
shutil.copytree(root.joinpath(".baseline/public"), baseline_site, dirs_exist_ok=True)
renderer ∈ str ← str(root.joinpath("examples/autogenerated/charcoal-browser/render.rb"))
subprocess.run(["ruby", renderer, str(root), str(site)], check=True)
subprocess.run(["ruby", renderer, str(root.joinpath(".baseline")), str(baseline_site)], check=True)
require(root.joinpath("server.rb").read_bytes() == root.joinpath(".baseline/server.rb").read_bytes(), "SERVER-UNCHANGED")
handler ∈ object ← functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(site))
server ∈ object ← http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
worker ∈ object ← threading.Thread(target=server.serve_forever, daemon=True)
worker.start()
baseline_handler ∈ object ← functools.partial(http.server.SimpleHTTPRequestHandler, directory=str(baseline_site))
baseline_server ∈ object ← http.server.ThreadingHTTPServer(("127.0.0.1", 0), baseline_handler)
baseline_worker ∈ object ← threading.Thread(target=baseline_server.serve_forever, daemon=True)
baseline_worker.start()
baseline_address ∈ str ← "http://127.0.0.1:" + str(baseline_server.server_address[1])
address ∈ str ← "http://127.0.0.1:" + str(server.server_address[1])
driver ∈ object ← sync_playwright().start()
browser ∈ object ← driver.chromium.launch()
try:
    for scheme in ["light", "dark"]:
        for width in [390, 1280]:
            context ∈ object ← browser.new_context(color_scheme=scheme, viewport={"width": width, "height": 900})
            context.route("**/*", local_requests_only)
            page ∈ object ← context.new_page()
            baseline ∈ object ← context.new_page()
            for view in ["", "apps/", "apps-populated/", "documentation/", "about/", "signup/"]:
                page.goto(address + "/" + view, wait_until="domcontentloaded")
                baseline.goto(baseline_address + "/" + view, wait_until="domcontentloaded")
                require(own_surface(page), "CHARCOAL-ROOT-" + view)
                require(str(page.inner_text("body")) == str(baseline.inner_text("body")), "ERB-CONTENT-UNCHANGED-" + view)
                structure ∈ str ← "() => JSON.stringify({links:Array.from(document.querySelectorAll('a')).map(e => e.getAttribute('href')),inputs:Array.from(document.querySelectorAll('input')).map(e=>[e.name,e.type]),forms:Array.from(document.querySelectorAll('form')).map(e=>[e.getAttribute('action'),e.getAttribute('method')])})"
                require(str(page.evaluate(structure)) == str(baseline.evaluate(structure)), "NAVIGATION-AND-FORMS-UNCHANGED-" + view)
                require(bool(page.evaluate("""() => ['.hero-unit','.well','.navbar-inner','.modal','.modal-body','.modal-footer'].every(selector => Array.from(document.querySelectorAll(selector)).every(e=>getComputedStyle(e).backgroundColor === 'rgb(47, 47, 47)'))""")), "RAISED-SURFACES-" + view)
                require(bool(page.evaluate("""() => {
                  const lum = value => {
                    const c = value.match(/[0-9.]+/g).slice(0,3).map(Number).map(v=>v/255).map(v=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4);
                    return c[0]*.2126+c[1]*.7152+c[2]*.0722;
                  };
                  return Array.from(document.querySelectorAll('p,li,label,button,input,pre,code,h1,h2,h3,h4,a')).filter(e=>e.getClientRects().length).every(e=>{
                    let parent=e, background;
                    while(parent){background=getComputedStyle(parent).backgroundColor;if(background!=='rgba(0, 0, 0, 0)')break;parent=parent.parentElement;}
                    const a=lum(getComputedStyle(e).color), b=lum(background||'rgb(33,33,33)');
                    return (Math.max(a,b)+.05)/(Math.min(a,b)+.05)>=4.5;
                  });
                }""")), "ORDINARY-TEXT-AA-" + view)
                label ∈ str ← (view.strip("/").replace("/", "-") or "index") + "-" + str(width) + "-" + scheme
                if view == "signup/":
                    page.locator("#inputEmail").fill("fixture@example.test")
                    page.locator("#inputPassword").fill("0000000000")
                    require(str(page.locator("#inputEmail").evaluate("(e)=>getComputedStyle(e).backgroundColor")) == "rgb(56, 56, 56)", "INPUT-SURFACE")
                    page.screenshot(path=str(output.joinpath(label + "-input.png")), full_page=True)
                    # Visual fixture of the retained modal; no jQuery interaction claim.
                    page.locator("#about").evaluate("(e)=>{e.classList.remove('hide');e.classList.remove('fade');e.style.display='block'}")
                page.screenshot(path=str(output.joinpath(label + ".png")), full_page=True)
                page.evaluate("document.body.style.backgroundColor='white';document.body.style.color='black'")
                require(not own_surface(page), "WHITE-ROOT-NEGATIVE")
            context.close()
    receipt ∈ str ← json.dumps({"actual_erb": "PASS", "phone_and_desktop": "PASS", "both_system_schemes": "PASS", "root_and_control_surfaces": "PASS", "ordinary_text_aa": "PASS", "content_navigation_form_structure": "PASS", "white_root_negative": "PASS", "legacy_telephony_backend": "NOT_RUN", "jquery_modal_interaction": "NOT_RUN", "physical_c67": "NOT_RUN"}, sort_keys=True, indent=2)
    output.joinpath("receipt.json").write_text(receipt + "\n", encoding="utf-8")
    print(receipt)
finally:
    browser.close()
    driver.stop()
    server.shutdown()
    server.server_close()
    baseline_server.shutdown()
    baseline_server.server_close()
